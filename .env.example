# Pixiv Web 侧登录态。可选但建议配置，使用专用账号。
# RefreshToken 模式下 App 不会提供有效的 x-auth，服务端只能用它为只读 Web 请求兜底。
# PIXIV_COOKIE="PHPSESSID=123_xxxxxxxx"

# 请求来源域名白名单（Origin / Referer 主机名）。留空则允许所有来源。
# 若启用，必须包含 App 的实际来源：
# - Web: pixiv.pictures（或自建域名）
# - Capacitor: localhost
# - Tauri: tauri.localhost / localhost
# ACCEPT_DOMAINS=pixiv.pictures,localhost,tauri.localhost

# User-Agent 黑名单。不要包含 App 的 UA 片段（App UA 可能带 PixivViewer）。
# UA_BLACKLIST=curl,bot,got,python,java,request,http,scan,inspect,netcraft

# 通用代理 /proxy/* 的域名白名单。留空允许所有公网域名。
# PROXY_ALLOW_DOMAINS=www.pixiv.net,www.pixivision.net

# 通用代理的域名黑名单。
# PROXY_BLOCK_DOMAINS=

# 是否阻断私网、回环、云元数据地址。正式环境必须保持 1。
PROXY_BLOCK_PRIVATE=1

# 是否在代理前做 DNS 解析检查（防 DNS rebinding）。正式环境必须保持 1。
# 仅在离线本地测试可临时设为 0。
PROXY_DNS_CHECK=1

# 根路径 URL 代理允许的目标主机。默认已包含 Pixiv 所需主机。
# 如需代理 Pixiv Story 的静态资源，可追加 s.pximg.net。
# ROOT_PROXY_ALLOW_DOMAINS=www.pixiv.net,www.pixivision.net

# 上游响应大小上限（字节），默认 20 MiB。
# MAX_DOWNLOAD_BYTES=20971520

# 上游请求超时（毫秒），默认 25000。
# UPSTREAM_TIMEOUT_MS=25000

# 必须不要设置 API_TOKEN：App 无法发送 X-Api-Token，设置后所有请求会 401。
# API_TOKEN=

# 本模式不需要服务端 Pixiv App 凭据，必须不要设置。
# PIXIV_ACCOUNT_TOKEN=
# PIXIV_ACCOUNT_TOKEN_ALTS=